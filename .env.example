# =============================================================================
# Claves para los scripts de Antigravity.
# 1. Copia este archivo y llama a la copia ".env.local" (en la misma carpeta).
# 2. Rellena los valores. ".env.local" NUNCA se sube a GitHub (.gitignore lo impide).
# 3. No pegues estas claves en el chat de Antigravity ni en ningún otro sitio.
# Guía paso a paso: docs/03-aprende-apis.md
# =============================================================================

# --- Supabase (tu base de datos) ---------------------------------------------
# Supabase → tu proyecto → Project Settings → API Keys
SUPABASE_URL=https://TU-PROYECTO.supabase.co
# La clave "publishable" (empieza por sb_publishable_). Es pública: la web
# también la usa. NUNCA pongas aquí la "secret" (sb_secret_...).
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# --- Cuenta del agente de Antigravity ----------------------------------------
# Es un usuario aparte, con menos permisos que tú (rol "agente").
# Se crea en Supabase → Authentication → Users → Add user.
AGENTE_EMAIL=agente@mavieiasolutions.com
AGENTE_PASSWORD=pon-aqui-una-contrasena-larga-de-bitwarden

# --- Serper (búsqueda en Google Maps) ----------------------------------------
# serper.dev → regístrate → API Key. 2.500 búsquedas gratis, sin tarjeta.
# Si lo dejas vacío, se busca en OpenStreetMap (gratis, sin clave, menos datos).
SERPER_API_KEY=
